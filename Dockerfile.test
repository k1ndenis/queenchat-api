FROM python:3.14-slim
WORKDIR /app
COPY requirements.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements-test.txt && apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY . .
ENV TESTING=true DATABASE_URL=sqlite:////tmp/queenchat-tests/database.db UPLOAD_ROOT=/tmp/queenchat-tests/uploads JWT_SECRET_KEY=queenchat-test-secret-at-least-32-bytes
CMD ["python", "-m", "pytest", "-q"]
